generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum IncidentSeverity {
  DEGRADED
  CRITICAL
}

enum IncidentStatus {
  OPEN
  RECOVERED
}

model User {
  id             String          @id
  username       String          @unique
  passwordHash   String
  nickname       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  role           UserRole        @default(USER)
  status         UserStatus      @default(ACTIVE)
  disabledAt     DateTime?
  disabledReason String?
  lastLoginAt    DateTime?
  neteaseAccount NeteaseAccount?
  qqMusicAccount QqMusicAccount?
  favoriteAlbums UserFavoriteAlbum[]
  favoriteTracks UserFavoriteTrack[]
  favoriteArtists UserFavoriteArtist[]
  tasteEvents      UserTasteEvent[]
  tasteEntities    UserTasteEntity[]
  recommendationExclusions UserRecommendationExclusion[]
  roomActivity   UserRoomActivity[]
  adminSessions  AdminSession[]
  userSessions   UserSession[]
  auditLogs      AdminAuditLog[]
}

model AdminSession {
  id           String    @id
  userId       String
  tokenHash    String    @unique
  csrfHash     String
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model NeteaseAccount {
  id              String    @id
  userId          String    @unique
  neteaseUserId   String?
  nickname        String?
  avatarUrl       String?
  encryptedCookie String
  lastValidatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QqMusicAccount {
  id              String    @id
  userId          String    @unique
  qqMusicUserId   String?
  nickname        String?
  avatarUrl       String?
  encryptedCookie String
  lastValidatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id        String   @id
  userId    String
  tokenHash  String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RoomState {
  id               String   @id
  hostId           String
  joinCode         String   @unique
  name             String   @default("未命名房间")
  description      String?
  passwordHash     String?
  visibility       String
  roomType         String          @default("interactive")
  roomRevision     Int      @default(0)
  presenceRevision Int      @default(0)
  playback         Json
  members          Json
  tracks           Json
  queue            Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Playlist {
  id              String   @id
  ownerId         String
  roomId          String?
  title           String
  description     String?
  coverUrl        String?
  tags            Json
  isCollaborative Boolean  @default(false)
  trackIds        Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ownerId, updatedAt])
  @@index([roomId])
}

model UserFavoriteAlbum {
  id              String   @id
  userId          String
  provider        String
  providerAlbumId String
  title           String
  artist          String
  artworkUrl      String?
  description     String?
  releaseTime     String?
  trackCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, providerAlbumId])
  @@index([userId, updatedAt])
}

model UserFavoriteTrack {
  id              String   @id
  userId          String
  provider        String
  providerTrackId String
  access          String
  quality         String?
  title           String
  artist          String
  album           String?
  providerAlbumId String?
  durationMs      Int      @default(0)
  artworkUrl      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, providerTrackId])
  @@index([userId, updatedAt])
}

model UserFavoriteArtist {
  id               String   @id
  userId           String
  provider         String
  providerArtistId String
  name             String
  artworkUrl       String?
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, providerArtistId])
  @@index([userId, updatedAt])
}

model UserTasteEvent {
  id            String   @id
  userId        String
  clientEventId String
  eventType     String
  surface       String?
  entityKind    String
  entityKey     String
  provider      String?
  providerItemId String?
  title         String?
  artist        String?
  album         String?
  durationMs    Int      @default(0)
  listenedMs    BigInt   @default(0)
  weight        Float    @default(0)
  timezoneOffsetMinutes Int @default(0)
  occurredAt    DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientEventId])
  @@index([userId, occurredAt])
}

model UserTasteEntity {
  id              String   @id
  userId          String
  entityKind      String
  entityKey       String
  provider        String?
  providerItemId  String?
  providerAlbumId String?
  access          String?
  quality         String?
  title           String?
  artist          String?
  album           String?
  durationMs      Int      @default(0)
  artworkUrl      String?
  positiveScore   Float    @default(0)
  negativeScore   Float    @default(0)
  confidence      Float    @default(0)
  interactionCount Int     @default(0)
  lastOccurredAt  DateTime?
  lastRecommendedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityKind, entityKey])
  @@index([userId, entityKind, lastOccurredAt])
}

model UserRecommendationExclusion {
  id              String   @id
  userId          String
  targetKind      String
  targetKey       String
  label           String?
  reason          String
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetKind, targetKey])
  @@index([userId, createdAt])
}

model UserRoomActivity {
  id              String    @id
  userId          String
  roomId          String
  roomType        String        @default("interactive")
  roomName        String
  joinCode        String
  totalDurationMs BigInt    @default(0)
  activeStartedAt DateTime?
  lastPresenceAt  DateTime?
  lastJoinedAt    DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([userId, lastJoinedAt])
}

model RoomReaction {
  id           String   @id
  roomId       String
  userId       String
  trackId      String?
  reactionType String
  createdAt    DateTime @default(now())

  @@index([roomId, trackId, reactionType, createdAt])
  @@index([userId, createdAt])
}

model RoomChatMessage {
  id         String   @id
  roomId     String
  senderId   String
  senderName String
  content    String
  createdAt  DateTime @default(now())

  @@index([roomId, createdAt, id])
}

model OperationalIncident {
  id              String           @id
  fingerprint     String           @unique
  type            String
  scopeType       String
  scopeId         String?
  severity        IncidentSeverity
  status          IncidentStatus   @default(OPEN)
  firstSeenAt     DateTime
  lastSeenAt      DateTime
  recoveredAt     DateTime?
  occurrenceCount Int              @default(1)
  details         Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, severity, lastSeenAt])
  @@index([scopeType, scopeId])
}

model AdminAuditLog {
  id          String   @id
  actorUserId String
  action      String
  targetType  String
  targetId    String?
  reason      String?
  result      String
  requestId   String?
  ipHash      String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
}

model RoomTombstone {
  id        String   @id
  roomId    String   @unique
  trackIds  Json
  reason    String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([status, createdAt])
  @@index([expiresAt])
}

model RoomTrackDeletion {
  id              String   @id
  roomId          String
  trackId         String
  fileHash        String?
  originalAssetId String?
  playbackAssetId String?
  roomRevision    Int
  deletedAt       DateTime @default(now())
  expiresAt       DateTime

  @@unique([roomId, trackId])
  @@index([roomId, roomRevision])
  @@index([expiresAt])
}
