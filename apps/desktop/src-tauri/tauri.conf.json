{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soqaro",
  "version": "1.0.0",
  "identifier": "com.soqaro.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @soqaro/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @soqaro/web build",
    "frontendDist": "https://soqaro.witw.top/app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Soqaro",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/witw123/soqaro/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwMUM2RkE1OTUzOEM0QTQKUldTa3hEaVZwVzhjVUpyZmNENmc1WWpSNEdXaHV4WnBHWS9QVzdVbC9MR3pLWGxtWENTMDN2aGYK"
    }
  }
}
